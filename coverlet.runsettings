<?xml version="1.0" encoding="utf-8"?>
<!-- used by "dotnet test" together with the XPlat Code Coverage collector (see README, Testing section).
     note: xml comments can't contain two dashes in a row, so the full command is in the README -->

<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- generated EF migrations and the test projects themselves don't count -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Exclude>[TaskManagement.*Tests]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
