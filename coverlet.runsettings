<?xml version="1.0" encoding="utf-8"?>
<!-- used with: dotnet test --collect:"XPlat Code Coverage" --settings coverlet.runsettings -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- generated EF migrations and the test projects themselves don't count -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <Exclude>[TaskManagement.*Tests]*</Exclude>
          <ExcludeByAttribute>GeneratedCodeAttribute,CompilerGeneratedAttribute</ExcludeByAttribute>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
